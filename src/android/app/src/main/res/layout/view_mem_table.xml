<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <!-- Top Row: Go back to scan on left, Status in middle, Clear on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Back to scan button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/mem_table_go_scan"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/mem_tab_scan"
            android:textSize="12sp"
            app:icon="@drawable/ic_back"
            app:iconGravity="start"
            app:iconPadding="4dp"
            app:iconSize="14dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mem_table_status"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textSize="12sp"
            tools:text="0 address(es), 0 frozen" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mem_table_clear"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/mem_table_clear"
            android:textSize="12sp"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <org.citron.citron_emu.features.memory.ui.NestedScrollableHost
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mem_table_entries"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            tools:listitem="@layout/list_item_freeze_entry" />

    </org.citron.citron_emu.features.memory.ui.NestedScrollableHost>

</LinearLayout>
